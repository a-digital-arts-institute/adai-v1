{
  "name": "adai-v1",
  "version": "1.0.0",
  "description": "A(DAI) — Digital Arts Knowledge Commons",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "seed:consolidated": "tsx src/seed-consolidated.ts",
    "embed:derive": "tsx src/embed/cli.ts derive",
    "embed:centroids": "tsx src/embed/cli.ts centroids",
    "embed:calibrate": "tsx src/embed/cli.ts calibrate",
    "embed:report-drift": "tsx src/embed/cli.ts report-drift",
    "embed:backfill": "tsx src/embed/cli.ts backfill",
    "token:issue": "tsx src/cli/issue-token.ts",
    "token:revoke": "tsx src/cli/revoke-token.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "audit:schema:fast": "seed/_build/.venv/bin/python3 seed/_build/audit_schema.py --tier fast",
    "audit:schema:full": "seed/_build/.venv/bin/python3 seed/_build/audit_schema.py --tier full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@google/genai": "^1.0.0",
    "@shards-lang/crsqlite": "^0.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
