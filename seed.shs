; seed.shs — reads ./results/*.json and populates the adai.db with nodes and edges

@define(adai-db "adai.db" IgnoreRedefined: true)

; --- slugify template: lowercase, replace spaces/underscores with hyphens, strip non-alnum ---
@template(slugify [input] {
  input
  | String.ToLower
  | Replace(["_"] "-")
  | Replace([" "] "-")
  | Replace(["("] "")
  | Replace([")"] "")
  | Replace(["."] "")
  | Replace(["'"] "")
  | Replace(["&"] "and")
  | Replace(["--"] "-")
})

; --- init DB ---
@wire(init-db {
  Msg("Setting database path...")
  @adai-db | Set(sqlite/database Global: true)

  Msg("Loading CR-SQLite extension...")
  DB.LoadExtension("crsqlite")

  Msg("Running schema from db.sql...")
  @read("db.sql") | DB.RawQuery

  Msg("Database initialized.")
})

; --- create the migration signal ---
@wire(create-migration-signal {
  ["signal-migration"
   "Initial seed migration"
   none
   "migration"
   none
   "Bulk import from research JSON files in ./results/"
   none
   "migration"
   "low"
   0]
  DB.Query("INSERT OR IGNORE INTO signals (id, title, source_url, source_type, cla_layer, summary, content, submitted_by, confidence, lived_experience) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" @adai-db)
  Msg("Migration signal created.")
})

; --- create the migration contributor ---
@wire(create-migration-contributor {
  ["contributor-migration" "migration" "script" "high" 0 0]
  DB.Query("INSERT OR IGNORE INTO contributors (id, name, type, trust_tier, contributions, approved_count) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)
  Msg("Migration contributor created.")
})

; --- process a single JSON file ---
@wire(process-file {
  = file-path
  {Log("Processing")}

  ; read and parse JSON
  file-path | FS.Read | Await(FromJson) | ExpectTable = data

  ; extract basic info
  data | Take("basic_info") | ExpectTable = basic-info
  basic-info | Take("name") | ExpectString = entity-name
  basic-info | Take("type") | ExpectString = entity-type

  ; build slug from entity name
  @slugify(entity-name) = slug

  ; build node id: type-slug
  [entity-type "-" slug] | String.Format = node-id

  ; store the full JSON as metadata
  data | Await(ToJson) = metadata-json

  ; insert node
  [node-id entity-type entity-name slug metadata-json "migration"]
  DB.Query("INSERT OR IGNORE INTO nodes (id, type, name, slug, metadata, updated_by) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)

  ; --- extract medium concepts and create PRACTICES edges ---
  data | Take("practice_description") | When(IsTable {
    ExpectTable | Take("medium") | When(IsString {
      ExpectString | String.Split(",") | ForEach({
        String.Trim = concept-name
        ; skip empty
        concept-name | WhenNot(Is("") {
          ; create concept slug and id
          @slugify(concept-name) = concept-slug
          ["concept-" concept-slug] | String.Format = concept-id

          ; insert concept node (ignore if exists)
          [concept-id "concept" concept-name concept-slug none "migration"]
          DB.Query("INSERT OR IGNORE INTO nodes (id, type, name, slug, metadata, updated_by) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)

          ; create PRACTICES edge
          [node-id "-practices-" concept-id] | String.Format = edge-id
          [edge-id node-id concept-id "PRACTICES" "signal-migration" "low" none "migration"]
          DB.Query("INSERT OR IGNORE INTO edges (id, source_id, target_id, edge_type, signal_id, confidence, charge, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?)" @adai-db)
        })
      })
    })
  })

  ; --- extract connections and create RELATED_TO edges ---
  data | Take("network_position") | When(IsTable {
    ExpectTable | Take("connections") | When(IsString {
      ExpectString | String.Split(",") | ForEach({
        String.Trim = connection-name
        ; skip empty
        connection-name | WhenNot(Is("") {
          ; strip parenthetical descriptions: "Ben Fry (Processing co-creator)" -> "Ben Fry"
          ; find the opening paren and take everything before it
          connection-name | String.Split("(") | Take(0) | String.Trim = clean-name

          ; create a slug for the connection target
          @slugify(clean-name) = conn-slug
          ["related-" conn-slug] | String.Format = conn-id

          ; insert as a generic related node (might already exist as a proper entity)
          [conn-id "related" clean-name conn-slug none "migration"]
          DB.Query("INSERT OR IGNORE INTO nodes (id, type, name, slug, metadata, updated_by) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)

          ; create RELATED_TO edge
          [node-id "-related-to-" conn-id] | String.Format = rel-edge-id
          [rel-edge-id node-id conn-id "RELATED_TO" "signal-migration" "low" none "migration"]
          DB.Query("INSERT OR IGNORE INTO edges (id, source_id, target_id, edge_type, signal_id, confidence, charge, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?)" @adai-db)
        })
      })
    })
  })

  ; --- extract scene affiliation for BELONGS_TO edges ---
  data | Take("network_position") | When(IsTable {
    ExpectTable | Take("scene_affiliation") | When(IsString {
      ExpectString | String.Split(",") | ForEach({
        String.Trim = scene-name
        scene-name | WhenNot(Is("") {
          ; strip parentheticals
          scene-name | String.Split("(") | Take(0) | String.Trim = clean-scene

          @slugify(clean-scene) = scene-slug
          ["scene-" scene-slug] | String.Format = scene-id

          ; insert scene node
          [scene-id "scene" clean-scene scene-slug none "migration"]
          DB.Query("INSERT OR IGNORE INTO nodes (id, type, name, slug, metadata, updated_by) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)

          ; create BELONGS_TO edge
          [node-id "-belongs-to-" scene-id] | String.Format = bt-edge-id
          [bt-edge-id node-id scene-id "BELONGS_TO" "signal-migration" "low" none "migration"]
          DB.Query("INSERT OR IGNORE INTO edges (id, source_id, target_id, edge_type, signal_id, confidence, charge, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?)" @adai-db)
        })
      })
    })
  })
})

; --- main seed wire ---
@wire(seed {
  Do(init-db)
  Do(create-migration-signal)
  Do(create-migration-contributor)

  Msg("Scanning ./results/ for JSON files...")

  ; list all json files in results directory
  "results" | FS.Iterate | ForEach({
    ExpectString = file-entry
    file-entry | When(String.Ends(With: ".json") {
      Do(process-file)
    })
  })

  ; report stats
  [] | DB.Query("SELECT COUNT(*) as count FROM nodes" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt | Log("Total nodes")

  [] | DB.Query("SELECT COUNT(*) as count FROM edges" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt | Log("Total edges")

  [] | DB.Query("SELECT type, COUNT(*) as count FROM nodes GROUP BY type" @adai-db)
  Log("Nodes by type")

  [] | DB.Query("SELECT edge_type, COUNT(*) as count FROM edges GROUP BY edge_type" @adai-db)
  Log("Edges by type")

  Msg("Seed complete!")
})

@mesh(main)
@schedule(main seed)
@run(main FPS: 15)
