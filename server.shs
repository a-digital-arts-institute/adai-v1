; server.shs — HTTP handlers and routing

@include("server-base.shs" Once: true)

; === HANDLER WIRES ===

; --- GET / — home page ---
@wire(handle-home {
  [] | DB.Query("SELECT COUNT(*) as count FROM nodes WHERE type NOT IN ('related', 'concept', 'scene')" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt | ToString = practitioner-count

  [] | DB.Query("SELECT COUNT(*) as count FROM edges" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt | ToString = edge-count

  [] | DB.Query("SELECT COUNT(DISTINCT type) as count FROM nodes" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt | ToString = type-count

  ["<h2>Digital Arts Knowledge Commons</h2>"
   "<p>A(DAI) maps practitioners, concepts, scenes, and their relationships "
   "across the digital arts landscape. A living graph built through collective contribution.</p>"
   "<div class='stats-grid'>"
   "<div class='stat-box'><div class='num'>" practitioner-count "</div><div class='label'>practitioners</div></div>"
   "<div class='stat-box'><div class='num'>" edge-count "</div><div class='label'>connections</div></div>"
   "<div class='stat-box'><div class='num'>" type-count "</div><div class='label'>node types</div></div>"
   "</div>"
   "<h2>Recent Additions</h2>"] | String.Format >= body

  Maybe({
    [] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE type NOT IN ('related', 'concept', 'scene') ORDER BY created_at DESC LIMIT 10" @adai-db)
    = recent
    recent | Take("name") | ExpectSeq = names
    recent | Take("type") | ExpectSeq = types
    recent | Take("slug") | ExpectSeq = slugs
    names | Count = n-recent

    0 >= idx
    Repeat({
      names | Take(idx) | ExpectString = rname
      types | Take(idx) | ExpectString = rtype
      slugs | Take(idx) | ExpectString = rslug
      ["<div class='card'><h3><a href='/practitioner/" rslug "'>" rname "</a></h3><span class='tag'>" rtype "</span></div>"] | String.Format | AppendTo(body)
      Inc(idx)
    } Times: n-recent)
  })

  @html-page("Home" body) = page
  page | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- GET /explore — list all practitioners ---
@wire(handle-explore {
  "<h2>Explore</h2><p class='meta'>0 practitioners, collectives, platforms, and projects</p>" >= body

  Maybe({
    [] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE type NOT IN ('related', 'concept', 'scene') ORDER BY name" @adai-db)
    = result
    result | Take("name") | ExpectSeq = names
    result | Take("type") | ExpectSeq = types
    result | Take("slug") | ExpectSeq = slugs
    names | Count = n-nodes

    ; rebuild body with actual count
    ["<h2>Explore</h2><p class='meta'>" n-nodes | ToString " practitioners, collectives, platforms, and projects</p>"] | String.Format > body

    0 >= idx
    Repeat({
      names | Take(idx) | ExpectString = ename
      types | Take(idx) | ExpectString = etype
      slugs | Take(idx) | ExpectString = eslug
      ["<div class='card'><h3><a href='/practitioner/" eslug "'>" ename "</a></h3><span class='tag'>" etype "</span></div>"] | String.Format | AppendTo(body)
      Inc(idx)
    } Times: n-nodes)
  })

  @html-page("Explore" body) = page
  page | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- GET /practitioner/:slug — profile page ---
@wire(handle-practitioner {
  = slug

  ; count first to avoid ExpectSeq on empty result
  0 >= prac-node-count
  Maybe({
    [slug] | DB.Query("SELECT COUNT(*) as count FROM nodes WHERE slug = ?" @adai-db)
    Take("count") | ExpectSeq | Take(0) | ExpectInt > prac-node-count
  })

  prac-node-count | When(Is(0) {
    @html-page("Not Found" "<h2>Not Found</h2><p>No practitioner with that slug.</p>") = page
    page | Http.Response(404 Headers: @html-headers)
    none | Stop
  })

  [slug] | DB.Query("SELECT id, name, type, slug, metadata FROM nodes WHERE slug = ?" @adai-db)
  = node-result
  node-result | Take("id") | ExpectSeq = ids

  ids | Take(0) | ExpectString = node-id
  node-result | Take("name") | ExpectSeq | Take(0) | ExpectString = node-name
  node-result | Take("type") | ExpectSeq | Take(0) | ExpectString = node-type
  node-result | Take("metadata") | ExpectSeq | Take(0) = raw-metadata

  ["<h2>" node-name "</h2><span class='tag'>" node-type "</span>"] | String.Format >= body

  ; parse metadata JSON if present
  raw-metadata | When(IsString {
    ExpectString | Await(FromJson) | ExpectTable = meta

    meta | Take("basic_info") | When(IsTable {
      ExpectTable = info
      "<div style='margin:1rem 0'>" | AppendTo(body)
      info | Take("location") | When(IsString {
        ExpectString = loc
        ["<p class='meta'>Location: " loc "</p>"] | String.Format | AppendTo(body)
      })
      info | Take("active_years") | When(IsString {
        ExpectString = years
        ["<p class='meta'>Active: " years "</p>"] | String.Format | AppendTo(body)
      })
      info | Take("url") | When(IsString {
        ExpectString = url
        ["<p class='meta'>Web: <a href='" url "'>" url "</a></p>"] | String.Format | AppendTo(body)
      })
      "</div>" | AppendTo(body)
    })

    meta | Take("practice_description") | When(IsTable {
      ExpectTable = practice
      practice | Take("practice_summary") | When(IsString {
        ExpectString = summary
        ["<h3>practice</h3><p>" summary "</p>"] | String.Format | AppendTo(body)
      })
      practice | Take("medium") | When(IsString {
        ExpectString | String.Split(",") = media
        "<div style='margin:0.5rem 0'>" | AppendTo(body)
        media | ForEach({
          String.Trim = m
          ["<span class='tag'>" m "</span>"] | String.Format | AppendTo(body)
        })
        "</div>" | AppendTo(body)
      })
      practice | Take("methodology") | When(IsString {
        ExpectString = meth
        ["<h3>methodology</h3><p>" meth "</p>"] | String.Format | AppendTo(body)
      })
    })

    meta | Take("key_works") | When(IsTable {
      ExpectTable | Take("works") | When(IsSeq {
        ExpectSeq = works
        "<h3>key works</h3>" | AppendTo(body)
        works | ForEach({
          ExpectTable = work
          work | Take("title") | ExpectString = wtitle
          "<div class='card'>" | AppendTo(body)
          ["<strong>" wtitle "</strong>"] | String.Format | AppendTo(body)
          work | Take("year") | When(IsNotNone {
            ToString = wyear
            [" <span class='meta'>(" wyear ")</span>"] | String.Format | AppendTo(body)
          })
          work | Take("description") | When(IsString {
            ExpectString = wdesc
            ["<p style='margin-top:0.4rem'>" wdesc "</p>"] | String.Format | AppendTo(body)
          })
          "</div>" | AppendTo(body)
        })
      })
    })

    meta | Take("commons_orientation") | When(IsTable {
      ExpectTable = commons
      commons | Take("commons_summary") | When(IsString {
        ExpectString = cs
        ["<h3>commons orientation</h3><p>" cs "</p>"] | String.Format | AppendTo(body)
      })
    })

    meta | Take("governance_model") | When(IsTable {
      ExpectTable = gov
      gov | Take("governance_detail") | When(IsString {
        ExpectString = gd
        ["<h3>governance</h3><p>" gd "</p>"] | String.Format | AppendTo(body)
      })
    })
  })

  ; approved community contributions
  Maybe({
    [node-id] | DB.Query("SELECT s.title, s.summary, s.content, s.source_url, s.submitted_by, s.created_at FROM signals s JOIN intake_queue iq ON iq.signal_id = s.id WHERE iq.target_node = ? AND iq.status = 'approved' ORDER BY s.created_at DESC" @adai-db)
    = contrib-result
    contrib-result | Take("title") | ExpectSeq = contrib-titles
    contrib-titles | Count = n-contribs

    When({n-contribs | IsMore(0)} {
      ["<h3>community contributions (" n-contribs | ToString ")</h3>"] | String.Format | AppendTo(body)
      contrib-result | Take("content") | ExpectSeq = contrib-contents
      contrib-result | Take("submitted_by") | ExpectSeq = contrib-authors
      contrib-result | Take("source_url") | ExpectSeq = contrib-urls

      0 >= cidx
      Repeat({
        "<div class='card'>" | AppendTo(body)
        contrib-titles | Take(cidx) | When(IsString {
          @html-escape(ExpectString) = ct
          ["<strong>" ct "</strong>"] | String.Format | AppendTo(body)
        })
        contrib-contents | Take(cidx) | When(IsString {
          @html-escape(ExpectString) = cc
          ["<p>" cc "</p>"] | String.Format | AppendTo(body)
        })
        contrib-urls | Take(cidx) | When(IsString {
          @html-escape(ExpectString) = cu
          ["<p class='meta'>Source: <a href='" cu "'>" cu "</a></p>"] | String.Format | AppendTo(body)
        })
        contrib-authors | Take(cidx) | When(IsString {
          @html-escape(ExpectString) = ca
          ["<p class='meta'>Contributed by: " ca "</p>"] | String.Format | AppendTo(body)
        })
        "</div>" | AppendTo(body)
        Inc(cidx)
      } Times: n-contribs)
    })
  })

  ; edges
  Maybe({
    [node-id node-id] | DB.Query("SELECT e.id, e.source_id, e.target_id, e.edge_type, n1.name as source_name, n1.slug as source_slug, n2.name as target_name, n2.slug as target_slug FROM edges e LEFT JOIN nodes n1 ON e.source_id = n1.id LEFT JOIN nodes n2 ON e.target_id = n2.id WHERE e.source_id = ? OR e.target_id = ?" @adai-db)
    = edges-result
    edges-result | Take("edge_type") | ExpectSeq = edge-types
    edge-types | Count = n-edges

    When({n-edges | IsMore(0)} {
      ["<h3>connections (" n-edges | ToString ")</h3><ul class='edge-list'>"] | String.Format | AppendTo(body)

      edges-result | Take("source_id") | ExpectSeq = src-ids
      edges-result | Take("target_id") | ExpectSeq = tgt-ids
      edges-result | Take("source_name") | ExpectSeq = src-names
      edges-result | Take("target_name") | ExpectSeq = tgt-names
      edges-result | Take("source_slug") | ExpectSeq = src-slugs
      edges-result | Take("target_slug") | ExpectSeq = tgt-slugs

      "" >= other-name
      "" >= other-slug
      0 >= eidx

      Repeat({
        edge-types | Take(eidx) | ExpectString = etype
        src-ids | Take(eidx) | ExpectString = src-id

        src-id | If(Is(node-id) {
            tgt-names | Take(eidx) | ToString > other-name
            tgt-slugs | Take(eidx) | ToString > other-slug
          } {
            src-names | Take(eidx) | ToString > other-name
            src-slugs | Take(eidx) | ToString > other-slug
          }
        )

        ["<li><span class='edge-type'>" etype "</span> <a href='/practitioner/" other-slug "'>" other-name "</a></li>"] | String.Format | AppendTo(body)
        Inc(eidx)
      } Times: n-edges)

      "</ul>" | AppendTo(body)
    })
  })

  ; data export link
  ["<p style='margin-top:2rem'><a href='/practitioner/" slug "/data' class='btn'>Export JSON</a></p>"] | String.Format | AppendTo(body)

  @html-page(node-name body) = page
  page | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- GET /practitioner/:slug/data — JSON data export ---
@wire(handle-practitioner-data {
  = slug

  ; count first to avoid ExpectSeq on empty result
  0 >= data-node-count
  Maybe({
    [slug] | DB.Query("SELECT COUNT(*) as count FROM nodes WHERE slug = ?" @adai-db)
    Take("count") | ExpectSeq | Take(0) | ExpectInt > data-node-count
  })

  data-node-count | When(Is(0) {
    {"error": "not found"} | Await(ToJson) | Http.Response(404 Headers: @json-headers)
    none | Stop
  })

  [slug] | DB.Query("SELECT id, name, type, slug, metadata, created_at, updated_by FROM nodes WHERE slug = ?" @adai-db)
  = node-result
  node-result | Take("id") | ExpectSeq = ids

  ids | Take(0) | ExpectString = node-id
  node-result | Take("name") | ExpectSeq | Take(0) | ExpectString = dname
  node-result | Take("type") | ExpectSeq | Take(0) | ExpectString = dtype
  node-result | Take("metadata") | ExpectSeq | Take(0) = dmeta
  node-result | Take("created_at") | ExpectSeq | Take(0) | ToString = dcreated
  node-result | Take("updated_by") | ExpectSeq | Take(0) | ToString = dupdated

  ; parse metadata into a table if it's a JSON string, otherwise empty table
  {} | ToAnyTable >= dmeta-parsed
  dmeta | When(IsString {
    Maybe({
      ExpectString | Await(FromJson) | ExpectTable | ToAnyTable > dmeta-parsed
    })
  })

  ; build node table
  {"id": node-id "name": dname "type": dtype
   "slug": slug "created_at": dcreated "updated_by": dupdated
   "metadata": dmeta-parsed} = node-table

  ; edges
  Sequence(de-rows Type: @type([{none: Type::Any}]))
  Maybe({
    [node-id node-id] | DB.Query("SELECT id, source_id, target_id, edge_type, confidence FROM edges WHERE source_id = ? OR target_id = ?" @adai-db AsRows: true) | ExpectSeq
    ForEach({
      ExpectTable >> de-rows
    })
  })

  ; signals linked through intake
  Sequence(ds-rows Type: @type([{none: Type::Any}]))
  Maybe({
    [node-id] | DB.Query("SELECT s.id, s.title, s.submitted_by FROM signals s JOIN intake_queue iq ON iq.signal_id = s.id WHERE iq.target_node = ? AND iq.status = 'approved'" @adai-db AsRows: true) | ExpectSeq
    ForEach({
      ExpectTable >> ds-rows
    })
  })

  {"node": node-table "edges": de-rows "signals": ds-rows} | Await(ToJson) | Http.Response(200 Headers: @json-headers)
  none | Stop
})

; --- GET /api/stats — JSON stats ---
@wire(handle-stats {
  [] | DB.Query("SELECT COUNT(*) as count FROM nodes" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt = total-nodes

  [] | DB.Query("SELECT COUNT(*) as count FROM edges" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt = total-edges

  [] | DB.Query("SELECT COUNT(*) as count FROM signals" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt = total-signals

  [] | DB.Query("SELECT COUNT(*) as count FROM intake_queue WHERE status = 'pending'" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt = pending-count

  {"total_nodes": total-nodes "total_edges": total-edges
   "total_signals": total-signals "pending_reviews": pending-count}
  Await(ToJson) | Http.Response(200 Headers: @json-headers)
  none | Stop
})

; --- GET /contribute — contribution form ---
@wire(handle-contribute {
  ; load practitioners for the dropdown
  "" >= options
  Maybe({
    [] | DB.Query("SELECT id, name, slug FROM nodes WHERE type NOT IN ('related', 'concept', 'scene') ORDER BY name" @adai-db)
    = prac-result
    prac-result | Take("name") | ExpectSeq = prac-names
    prac-result | Take("id") | ExpectSeq = prac-ids
    prac-names | Count = prac-count

    ; build option tags
    0 >= pidx
    Repeat({
      prac-ids | Take(pidx) | ExpectString = pid
      prac-names | Take(pidx) | ExpectString = pname
      ["<option value='" pid "'>" pname "</option>"] | String.Format | AppendTo(options)
      Inc(pidx)
    } Times: prac-count)
  })

  ["<h2>Contribute a Signal</h2>"
   "<p>Submit information about a practitioner. Contributions from new contributors go to the review queue.</p>"
   "<form id='contribute-form'>"
   "<label>About which practitioner</label>"
   "<select name='target_node' required>" options "</select>"
   "<label>Signal title</label>"
   "<input type='text' name='title' placeholder='e.g. New exhibition at Serpentine' required>"
   "<label>Content</label>"
   "<textarea name='content' placeholder='Describe the signal...' required></textarea>"
   "<label>Source URL (optional)</label>"
   "<input type='text' name='source_url' placeholder='https://...'>"
   "<label>Your name</label>"
   "<input type='text' name='contributor_name' placeholder='Your name or handle' required>"
   "<button type='submit' class='btn' style='margin-top:1rem'>Submit Signal</button>"
   "</form>"
   "<div id='result'></div>"
   "<script>"
   "document.getElementById('contribute-form').addEventListener('submit',function(e){"
   "e.preventDefault();"
   "var fd=new FormData(this);"
   "var d={};"
   "fd.forEach(function(v,k){d[k]=v;});"
   "fetch('/api/contribute',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)})"
   ".then(function(r){return r.text();})"
   ".then(function(h){document.getElementById('result').innerHTML=h;document.getElementById('contribute-form').reset();});"
   "});"
   "</script>"] | String.Format = form-body

  @html-page("Contribute" form-body) = page
  page | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- POST /api/contribute — submit a signal ---
@wire(handle-contribute-post {
  = contrib-input

  contrib-input | Take("target_node") | ExpectString = target-node
  contrib-input | Take("title") | ExpectString = sig-title
  contrib-input | Take("content") | ExpectString = sig-content
  contrib-input | Take("contributor_name") | ExpectString = contributor-name

  ; source_url is optional
  "" >= source-url
  contrib-input | Take("source_url") | When(IsString {
    ExpectString > source-url
  })

  ; generate IDs
  RandomBytes(8) | ToHex = sig-suffix
  ["signal-" sig-suffix] | String.Format = signal-id
  RandomBytes(8) | ToHex = intake-suffix
  ["intake-" intake-suffix] | String.Format = intake-id

  ; look up contributor trust tier, default to 'low'
  "low" >= trust-tier
  Maybe({
    [contributor-name] | DB.Query("SELECT trust_tier FROM contributors WHERE name = ?" @adai-db)
    Take("trust_tier") | ExpectSeq | Take(0) | ExpectString > trust-tier
  })

  ; insert signal
  [signal-id sig-title source-url "contribution" none none sig-content contributor-name trust-tier 0]
  DB.Query("INSERT INTO signals (id, title, source_url, source_type, cla_layer, summary, content, submitted_by, confidence, lived_experience) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" @adai-db)

  ; determine intake status: auto-approve for high trust
  "pending" >= intake-status
  trust-tier | When(Is("high") {
    "approved" > intake-status
  })

  ; insert intake queue entry
  [intake-id signal-id target-node contributor-name trust-tier intake-status]
  DB.Query("INSERT INTO intake_queue (id, signal_id, target_node, submitted_by, trust_tier, status) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)

  ; update or create contributor record
  false >= contrib-exists
  Maybe({
    [contributor-name] | DB.Query("SELECT id FROM contributors WHERE name = ?" @adai-db)
    Take("id") | ExpectSeq | Count | When(IsMore(0) {
      true > contrib-exists
    })
  })
  contrib-exists | If(IsFalse {
      ; new contributor
      RandomBytes(8) | ToHex = contrib-id-suffix
      ["contributor-" contrib-id-suffix] | String.Format = contrib-id
      [contrib-id contributor-name "contributor" "low" 1 0]
      DB.Query("INSERT INTO contributors (id, name, type, trust_tier, contributions, approved_count) VALUES (?, ?, ?, ?, ?, ?)" @adai-db)
    } {
      ; existing — increment contribution count
      [contributor-name] | DB.Query("UPDATE contributors SET contributions = contributions + 1 WHERE name = ?" @adai-db)
    }
  )

  ; build response snippet
  intake-status | If(Is("approved") {
      "<div class='msg msg-ok'>Signal submitted and auto-approved (high trust). It is now live.</div>"
    } {
      "<div class='msg msg-ok'>Signal submitted successfully. It has been queued for review.</div>"
    }
  ) = response-html

  response-html | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- GET /review — review queue ---
@wire(handle-review {
  ; load pending intake items — count first to avoid ExpectSeq on empty result
  [] | DB.Query("SELECT COUNT(*) as count FROM intake_queue WHERE status = 'pending'" @adai-db)
  Take("count") | ExpectSeq | Take(0) | ExpectInt = q-count

  ["<h2>Review Queue</h2><p class='meta'>" q-count | ToString " pending signals</p>"] | String.Format >= body

  When({q-count | Is(0)} {
    "<p>No pending signals to review.</p>" | AppendTo(body)
  })

  When({q-count | IsMore(0)} {
    [] | DB.Query("SELECT iq.id, iq.signal_id, iq.target_node, iq.submitted_by, iq.trust_tier, iq.created_at, s.title, s.content, s.source_url, n.name as target_name FROM intake_queue iq LEFT JOIN signals s ON iq.signal_id = s.id LEFT JOIN nodes n ON iq.target_node = n.id WHERE iq.status = 'pending' ORDER BY iq.created_at DESC" @adai-db)
    = queue-result
    queue-result | Take("id") | ExpectSeq = q-ids
    queue-result | Take("signal_id") | ExpectSeq = q-sig-ids
    queue-result | Take("submitted_by") | ExpectSeq = q-authors
    queue-result | Take("trust_tier") | ExpectSeq = q-tiers
    queue-result | Take("title") | ExpectSeq = q-titles
    queue-result | Take("content") | ExpectSeq = q-contents
    queue-result | Take("source_url") | ExpectSeq = q-urls
    queue-result | Take("target_name") | ExpectSeq = q-targets
    queue-result | Take("created_at") | ExpectSeq = q-dates

    0 >= qi
    Repeat({
      q-ids | Take(qi) | ExpectString = qid
      @html-escape((q-titles | Take(qi) | ToString)) = qtitle
      @html-escape((q-contents | Take(qi) | ToString)) = qcontent
      @html-escape((q-urls | Take(qi) | ToString)) = qurl
      @html-escape((q-authors | Take(qi) | ToString)) = qauthor
      @html-escape((q-tiers | Take(qi) | ToString)) = qtier
      @html-escape((q-targets | Take(qi) | ToString)) = qtarget
      q-dates | Take(qi) | ToString = qdate

      ["<div class='card' id='item-" qid "'>"
       "<h3>" qtitle "</h3>"
       "<p class='meta'>About: <strong>" qtarget "</strong> · By: " qauthor
       " · Trust: <span class='tag'>" qtier "</span> · " qdate "</p>"
       "<p>" qcontent "</p>"] | String.Format | AppendTo(body)

      qurl | WhenNot(Is("") {
        ["<p class='meta'>Source: <a href='" qurl "'>" qurl "</a></p>"] | String.Format | AppendTo(body)
      })

      ["<div style='margin-top:0.5rem'>"
       "<button class='btn btn-approve' onclick=\"reviewAction('" qid "','approve')\">Approve</button>"
       "<button class='btn btn-reject' onclick=\"reviewAction('" qid "','reject')\">Reject</button>"
       "<input type='text' id='reason-" qid "' placeholder='Rejection reason...' style='width:auto;display:inline-block;margin-left:0.5rem;padding:0.4rem'>"
       "</div></div>"] | String.Format | AppendTo(body)
      Inc(qi)
    } Times: q-count)
  })

  ; also show recent approved/rejected
  Maybe({
    [] | DB.Query("SELECT iq.id, iq.status, iq.reviewed_at, s.title, n.name as target_name FROM intake_queue iq LEFT JOIN signals s ON iq.signal_id = s.id LEFT JOIN nodes n ON iq.target_node = n.id WHERE iq.status != 'pending' ORDER BY iq.reviewed_at DESC LIMIT 10" @adai-db)
    = recent-result
    recent-result | Take("id") | ExpectSeq = r-ids
    r-ids | Count = r-count

    When({r-count | IsMore(0)} {
      "<h3>recent decisions</h3>" | AppendTo(body)
      recent-result | Take("status") | ExpectSeq = r-statuses
      recent-result | Take("title") | ExpectSeq = r-titles
      recent-result | Take("target_name") | ExpectSeq = r-targets

      0 >= ri
      Repeat({
        r-statuses | Take(ri) | ToString = rstatus
        r-titles | Take(ri) | ToString = rtitle
        r-targets | Take(ri) | ToString = rtarget
        ["<div class='card'><span class='status-" rstatus "'>" rstatus "</span> "
         rtitle " — " rtarget "</div>"] | String.Format | AppendTo(body)
        Inc(ri)
      } Times: r-count)
    })
  })

  ; review action JS
  ["<script>"
   "function reviewAction(id,action){"
   "var body={};"
   "if(action==='reject'){"
   "var r=document.getElementById('reason-'+id).value;"
   "if(!r){alert('Please enter a rejection reason');return;}"
   "body.reason=r;}"
   "fetch('/api/review/'+id+'/'+action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})"
   ".then(function(r){return r.text();})"
   ".then(function(){var el=document.getElementById('item-'+id);if(el){el.style.opacity='0.3';el.innerHTML+='<p class=\"meta\">'+action+'d</p>';}});"
   "}"
   "</script>"] | String.Format | AppendTo(body)

  @html-page("Review Queue" body) = page
  page | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- POST /api/review/:id/approve ---
@wire(handle-review-approve {
  = approve-id

  ; check intake item exists and is pending
  [approve-id] | DB.Query("SELECT id, signal_id, target_node FROM intake_queue WHERE id = ? AND status = 'pending'" @adai-db)
  = iq-approve
  iq-approve | Take("id") | ExpectSeq = iq-a-ids
  iq-a-ids | Count | When(Is(0) {
    {"error": "not found or already reviewed"} | Await(ToJson) | Http.Response(404 Headers: @json-headers)
    none | Stop
  })

  ; update intake status
  [approve-id] | DB.Query("UPDATE intake_queue SET status = 'approved', reviewed_by = 'curator', reviewed_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = ?" @adai-db)

  ; update contributor approved_count
  [approve-id] | DB.Query("SELECT submitted_by FROM intake_queue WHERE id = ?" @adai-db)
  Take("submitted_by") | ExpectSeq | Take(0) | ExpectString = a-contrib-name
  [a-contrib-name] | DB.Query("UPDATE contributors SET approved_count = approved_count + 1 WHERE name = ?" @adai-db)

  "<div class='msg msg-ok'>Signal approved and is now live.</div>" | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- POST /api/review/:id/reject ---
@wire(handle-review-reject {
  ExpectTable = reject-input
  reject-input | Take("id") | ExpectString = reject-id
  reject-input | Take("reason") | ExpectString = reject-reason

  ; check intake item exists and is pending
  [reject-id] | DB.Query("SELECT id FROM intake_queue WHERE id = ? AND status = 'pending'" @adai-db)
  = iq-reject
  iq-reject | Take("id") | ExpectSeq = iq-r-ids
  iq-r-ids | Count | When(Is(0) {
    {"error": "not found or already reviewed"} | Await(ToJson) | Http.Response(404 Headers: @json-headers)
    none | Stop
  })

  ; update intake status
  [reject-reason reject-id] | DB.Query("UPDATE intake_queue SET status = 'rejected', rejection_reason = ?, reviewed_by = 'curator', reviewed_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = ?" @adai-db)

  "<div class='msg msg-err'>Signal rejected.</div>" | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; --- GET /api/graph — full graph as D3-compatible JSON ---
; Supports ?type= filter to narrow node types
@wire(handle-api-graph {
  = query-target ; the full target URL for query param parsing

  ; check for ?type= filter
  "" >= type-filter
  query-target | String.Split("?type=") = type-parts
  type-parts | Count | When(IsMoreEqual(2) {
    type-parts | Take(1) | ExpectString > type-filter
  })

  ; build nodes array
  Sequence(graph-nodes Type: @type([{none: Type::Any}]))
  Maybe({
    type-filter | If(Is("") {
        ; default: practitioners + concepts (concepts are what connect practitioners via PRACTICES edges)
        [] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE type NOT IN ('related', 'scene') ORDER BY name" @adai-db AsRows: true)
      } {
        type-filter | If(Is("_all") {
            ; everything except 'related'
            [] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE type != 'related' ORDER BY name" @adai-db AsRows: true)
          } {
            [type-filter] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE type = ? ORDER BY name" @adai-db AsRows: true)
          }
        )
      }
    ) | ExpectSeq | ForEach({
      ExpectTable >> graph-nodes
    })
  })

  ; build edges array — only include edges where BOTH source and target are in the node set
  Sequence(graph-edges Type: @type([{none: Type::Any}]))
  Maybe({
    ; edges: include only edges where BOTH endpoints are in the returned node set
    ; NOTE: the default view includes all edge types (PRACTICES, BELONGS_TO, RELATED_TO, etc.)
    ; between non-related, non-scene nodes. Practitioners connect via shared concept nodes
    ; through PRACTICES edges. The JS handles adding scene nodes/edges when toggled.
    type-filter | If(Is("") {
        ; default: edges between practitioners and concepts
        [] | DB.Query("SELECT e.source_id AS source, e.target_id AS target, e.edge_type AS type, e.confidence FROM edges e WHERE e.source_id IN (SELECT id FROM nodes WHERE type NOT IN ('related','scene')) AND e.target_id IN (SELECT id FROM nodes WHERE type NOT IN ('related','scene'))" @adai-db AsRows: true)
      } {
        type-filter | If(Is("_all") {
            [] | DB.Query("SELECT e.source_id AS source, e.target_id AS target, e.edge_type AS type, e.confidence FROM edges e WHERE e.source_id IN (SELECT id FROM nodes WHERE type != 'related') AND e.target_id IN (SELECT id FROM nodes WHERE type != 'related')" @adai-db AsRows: true)
          } {
            [type-filter type-filter] | DB.Query("SELECT e.source_id AS source, e.target_id AS target, e.edge_type AS type, e.confidence FROM edges e WHERE e.source_id IN (SELECT id FROM nodes WHERE type = ?) AND e.target_id IN (SELECT id FROM nodes WHERE type = ?)" @adai-db AsRows: true)
          }
        )
      }
    ) | ExpectSeq | ForEach({
      ExpectTable >> graph-edges
    })
  })

  {"nodes": graph-nodes "edges": graph-edges} | Await(ToJson) | Http.Response(200 Headers: @json-headers)
  none | Stop
})

; --- GET /api/graph/:slug — ego graph (1-hop from a node) ---
@wire(handle-api-graph-ego {
  = ego-slug

  ; count first to avoid ExpectSeq on empty result
  0 >= ego-node-count
  Maybe({
    [ego-slug] | DB.Query("SELECT COUNT(*) as count FROM nodes WHERE slug = ?" @adai-db)
    Take("count") | ExpectSeq | Take(0) | ExpectInt > ego-node-count
  })

  ego-node-count | When(Is(0) {
    {"error": "not found"} | Await(ToJson) | Http.Response(404 Headers: @json-headers)
    none | Stop
  })

  ; find the node (safe now — we know it exists)
  [ego-slug] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE slug = ?" @adai-db)
  = ego-node
  ego-node | Take("id") | ExpectSeq = ego-ids

  ego-ids | Take(0) | ExpectString = ego-id
  ego-node | Take("name") | ExpectSeq | Take(0) | ExpectString = ego-name
  ego-node | Take("type") | ExpectSeq | Take(0) | ExpectString = ego-type

  ; start with the center node
  Sequence(ego-nodes Type: @type([{none: Type::Any}]))
  {"id": ego-id "name": ego-name "type": ego-type "slug": ego-slug "center": true} >> ego-nodes

  ; get edges, then get connected node info separately
  Sequence(ego-edges Type: @type([{none: Type::Any}]))

  Maybe({
    [ego-id ego-id] | DB.Query("SELECT source_id, target_id, edge_type, confidence FROM edges WHERE source_id = ? OR target_id = ?" @adai-db AsRows: true) | ExpectSeq
    ForEach({
      ExpectTable = edge-row

      ; build edge with renamed keys for D3
      {"source": (edge-row | Take("source_id") | ExpectString)
       "target": (edge-row | Take("target_id") | ExpectString)
       "type": (edge-row | Take("edge_type") | ExpectString)
       "confidence": (edge-row | Take("confidence") | ToString)} >> ego-edges

      ; add the "other" node
      edge-row | Take("source_id") | ExpectString | If(Is(ego-id) {
          edge-row | Take("target_id") | ExpectString
        } {
          edge-row | Take("source_id") | ExpectString
        }
      ) = neighbor-id

      ; query neighbor details
      Maybe({
        [neighbor-id] | DB.Query("SELECT id, name, type, slug FROM nodes WHERE id = ?" @adai-db AsRows: true)
        ExpectSeq | Take(0) | ExpectTable >> ego-nodes
      })
    })
  })

  {"nodes": ego-nodes "edges": ego-edges} | Await(ToJson) | Http.Response(200 Headers: @json-headers)
  none | Stop
})

; --- GET /graph — D3 force-directed visualization page ---
@wire(handle-graph {
  ; the entire D3 viz is inline — no external deps
  """<div id='graph-container' style='position:relative'>
<div id='controls' style='position:absolute;top:0;left:0;z-index:10;padding:0.5rem'>
<select id='type-filter' style='background:#111;color:#d4d4d4;border:1px solid #333;padding:0.3rem;border-radius:3px;font-size:0.8rem'>
<option value=''>Practitioners + Concepts</option>
<option value='artist'>Artists only</option>
<option value='collective'>Collectives only</option>
<option value='platform'>Platforms only</option>
<option value='theorist'>Theorists only</option>
<option value='_all'>Everything</option>
</select>
<label style='margin-left:0.5rem;font-size:0.8rem;color:#666'><input type='checkbox' id='show-scenes'> + Scenes</label>
<span id='node-count' style='margin-left:1rem;font-size:0.75rem;color:#555'></span>
</div>
<svg id='graph-svg'></svg>
<div id='detail-panel' style='display:none;position:absolute;top:0;right:0;width:280px;background:#0f0f0f;border:1px solid #222;border-radius:4px;padding:1rem;max-height:80vh;overflow-y:auto;z-index:10'>
<button onclick='closePanel()' style='float:right;background:none;border:none;color:#666;cursor:pointer;font-size:1.2rem'>×</button>
<h3 id='detail-name' style='margin:0 0 0.3rem;color:#e8e8e8'></h3>
<span id='detail-type' class='tag'></span>
<div id='detail-connections' style='margin-top:0.8rem'></div>
<a id='detail-link' href='#' style='display:block;margin-top:0.8rem;font-size:0.85rem'>View full profile →</a>
</div>
</div>
<script src='https://d3js.org/d3.v7.min.js'></script>
<script>
var typeColors={
  artist:'#7eb8da',collective:'#da7e7e',platform:'#7eda98',
  theorist:'#dab87e',institution:'#b87eda',project:'#7edac4',
  concept:'#555',scene:'#444',related:'#333',
  'artist-collective':'#da7e7e','artist-project':'#7edac4',
  'artist-writer':'#dab87e',artwork:'#b87eda',
  'exhibition-publication':'#7eda98',gallery:'#da7e7e',
  report:'#555',theoretical:'#dab87e'
};
var confidenceWidth={high:2.5,medium:1.5,low:0.8,unverified:0.4};
var svg=d3.select('#graph-svg');
var width,height;
var simulation,link,node,label;
var currentData={nodes:[],edges:[]};
var selectedNode=null;

function resize(){
  width=window.innerWidth;
  height=window.innerHeight-120;
  svg.attr('width',width).attr('height',height);
  if(simulation)simulation.force('center',d3.forceCenter(width/2,height/2)).alpha(0.3).restart();
}
resize();
window.addEventListener('resize',resize);

function loadGraph(url){
  fetch(url).then(function(r){return r.json();}).then(function(data){
    currentData=data;
    document.getElementById('node-count').textContent=data.nodes.length+' nodes, '+data.edges.length+' edges';
    render(data);
  });
}

function render(data){
  svg.selectAll('*').remove();
  var g=svg.append('g');

  // zoom
  svg.call(d3.zoom().scaleExtent([0.1,8]).on('zoom',function(e){g.attr('transform',e.transform);}));

  // build lookup
  var nodeMap={};
  data.nodes.forEach(function(n){nodeMap[n.id]=n;});
  // filter edges to only those with both endpoints present
  var validEdges=data.edges.filter(function(e){return nodeMap[e.source||e.source.id]&&nodeMap[e.target||e.target.id];});

  simulation=d3.forceSimulation(data.nodes)
    .force('link',d3.forceLink(validEdges).id(function(d){return d.id;}).distance(80))
    .force('charge',d3.forceManyBody().strength(-120))
    .force('center',d3.forceCenter(width/2,height/2))
    .force('collision',d3.forceCollide(20));

  link=g.append('g').selectAll('line').data(validEdges).enter().append('line')
    .attr('stroke','#222')
    .attr('stroke-width',function(d){return confidenceWidth[d.confidence]||1;})
    .attr('stroke-opacity',0.6);

  node=g.append('g').selectAll('circle').data(data.nodes).enter().append('circle')
    .attr('r',function(d){return d.center?12:(d.type==='concept'||d.type==='scene')?4:8;})
    .attr('fill',function(d){return typeColors[d.type]||'#555';})
    .attr('stroke',function(d){return d.center?'#fff':'none';})
    .attr('stroke-width',function(d){return d.center?2:0;})
    .attr('cursor','pointer')
    .call(d3.drag().on('start',dragStart).on('drag',dragging).on('end',dragEnd))
    .on('click',function(e,d){selectNode(d);});

  node.append('title').text(function(d){return d.name+' ('+d.type+')';});

  label=g.append('g').selectAll('text').data(data.nodes).enter().append('text')
    .text(function(d){return d.name;})
    .attr('font-size','9px')
    .attr('fill','#888')
    .attr('dx',12)
    .attr('dy',3)
    .style('pointer-events','none');

  simulation.on('tick',function(){
    link.attr('x1',function(d){return d.source.x;}).attr('y1',function(d){return d.source.y;})
        .attr('x2',function(d){return d.target.x;}).attr('y2',function(d){return d.target.y;});
    node.attr('cx',function(d){return d.x;}).attr('cy',function(d){return d.y;});
    label.attr('x',function(d){return d.x;}).attr('y',function(d){return d.y;});
  });
}

function selectNode(d){
  selectedNode=d;
  // highlight
  node.attr('opacity',function(n){
    if(n.id===d.id)return 1;
    var connected=currentData.edges.some(function(e){
      var s=e.source.id||e.source,t=e.target.id||e.target;
      return(s===d.id&&t===n.id)||(t===d.id&&s===n.id);
    });
    return connected?1:0.15;
  });
  link.attr('stroke',function(e){
    var s=e.source.id||e.source,t=e.target.id||e.target;
    return(s===d.id||t===d.id)?typeColors[d.type]||'#7eb8da':'#222';
  }).attr('stroke-opacity',function(e){
    var s=e.source.id||e.source,t=e.target.id||e.target;
    return(s===d.id||t===d.id)?0.9:0.15;
  });
  label.attr('opacity',function(n){
    if(n.id===d.id)return 1;
    var connected=currentData.edges.some(function(e){
      var s=e.source.id||e.source,t=e.target.id||e.target;
      return(s===d.id&&t===n.id)||(t===d.id&&s===n.id);
    });
    return connected?0.8:0.05;
  });

  // detail panel
  var panel=document.getElementById('detail-panel');
  document.getElementById('detail-name').textContent=d.name;
  document.getElementById('detail-type').textContent=d.type;
  document.getElementById('detail-link').href='/practitioner/'+d.slug;

  var conns=currentData.edges.filter(function(e){
    var s=e.source.id||e.source,t=e.target.id||e.target;
    return s===d.id||t===d.id;
  });
  var html='<p style="font-size:0.8rem;color:#666">'+conns.length+' connections</p><ul style="list-style:none;padding:0">';
  conns.forEach(function(e){
    var s=e.source.id||e.source,t=e.target.id||e.target;
    var otherId=(s===d.id)?t:s;
    var other=currentData.nodes.find(function(n){return n.id===otherId;});
    if(other)html+='<li style="padding:0.2rem 0;font-size:0.8rem;border-bottom:1px solid #111"><span style="color:#555;font-family:monospace;font-size:0.7rem">'+e.type+'</span> '+other.name+'</li>';
  });
  html+='</ul>';
  document.getElementById('detail-connections').innerHTML=html;
  panel.style.display='block';
}

function closePanel(){
  document.getElementById('detail-panel').style.display='none';
  if(node){node.attr('opacity',1);link.attr('stroke','#222').attr('stroke-opacity',0.6);label.attr('opacity',1);}
  selectedNode=null;
}

function dragStart(e,d){if(!e.active)simulation.alphaTarget(0.3).restart();d.fx=d.x;d.fy=d.y;}
function dragging(e,d){d.fx=e.x;d.fy=e.y;}
function dragEnd(e,d){if(!e.active)simulation.alphaTarget(0);d.fx=null;d.fy=null;}

// filter controls
function reloadGraph(){
  var v=document.getElementById('type-filter').value;
  var scenes=document.getElementById('show-scenes').checked;
  var url='/api/graph';
  if(v)url+='?type='+v;
  // load base graph
  fetch(url).then(function(r){return r.json();}).then(function(data){
    if(scenes){
      // also fetch scene nodes+edges and merge
      fetch('/api/graph?type=scene').then(function(r){return r.json();}).then(function(sc){
        data.nodes=data.nodes.concat(sc.nodes);
        // get cross-type edges from _all
        fetch('/api/graph?type=_all').then(function(r){return r.json();}).then(function(all){
          var ids=new Set(data.nodes.map(function(n){return n.id;}));
          all.edges.forEach(function(e){
            if(ids.has(e.source)&&ids.has(e.target)){
              var dup=data.edges.some(function(x){return x.source===e.source&&x.target===e.target&&x.type===e.type;});
              if(!dup)data.edges.push(e);
            }
          });
          currentData=data;
          document.getElementById('node-count').textContent=data.nodes.length+' nodes, '+data.edges.length+' edges';
          render(data);
        });
      });
    } else {
      currentData=data;
      document.getElementById('node-count').textContent=data.nodes.length+' nodes, '+data.edges.length+' edges';
      render(data);
    }
  });
}
document.getElementById('type-filter').addEventListener('change',reloadGraph);
document.getElementById('show-scenes').addEventListener('change',reloadGraph);

// initial load — practitioners only (59 nodes)
loadGraph('/api/graph');

// also support clicking svg background to deselect
svg.on('click',function(e){if(e.target.tagName==='svg')closePanel();});
</script>""" = graph-body

  ; the graph page needs full-width, override .wrap
  ["<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Graph — A(DAI)</title><style>"
   @css
   "#graph-container{margin:-2rem -1.5rem}#graph-svg{background:#0a0a0a;display:block}"
   "</style></head><body><div class='wrap'><header><h1>A<span>(DAI)</span></h1><nav><a href='/'>Home</a><a href='/explore'>Explore</a><a href='/graph'>Graph</a><a href='/contribute'>Contribute</a><a href='/review'>Review</a><a href='/api/stats'>Stats</a></nav></header>"
   graph-body
   "<footer>A(DAI) — digital arts knowledge commons</footer></div></body></html>"] | String.Format = page

  page | Http.Response(200 Headers: @html-headers)
  none | Stop
})

; === ROUTING ===

@wire(server-handler {
  Http.Read
  {Take("method") = method}
  {Take("target") = target | Log("Request")}
  {Take("body") = raw-body}

  method | Match([
    "GET" {
      target | Cond([
        {Is("/")} {
          Do(handle-home)
        }
        {Is("/explore")} {
          Do(handle-explore)
        }
        {Is("/contribute")} {
          Do(handle-contribute)
        }
        {Is("/review")} {
          Do(handle-review)
        }
        {Is("/api/stats")} {
          Do(handle-stats)
        }
        {Is("/graph")} {
          Do(handle-graph)
        }
        {String.Starts(With: "/api/graph")} {
          ; /api/graph or /api/graph?type=X or /api/graph/:slug
          target | String.Split("?") | Take(0) | ExpectString = graph-path
          graph-path | String.Split("/") = graph-parts
          ; /api/graph -> ["" "api" "graph"]  (3 parts)
          ; /api/graph/casey-reas -> ["" "api" "graph" "casey-reas"]  (4 parts)
          graph-parts | Count | If(IsMoreEqual(4) {
              graph-parts | Take(3) | ExpectString | Do(handle-api-graph-ego)
            } {
              target | Do(handle-api-graph)
            }
          )
        }
        {String.Starts(With: "/practitioner/")} {
          target | String.Split("/") = parts
          ; /practitioner/:slug -> ["" "practitioner" slug]
          ; /practitioner/:slug/data -> ["" "practitioner" slug "data"]
          parts | Count | If(IsMoreEqual(4) {
              parts | Take(3) | ExpectString | If(Is("data") {
                  parts | Take(2) | ExpectString | Do(handle-practitioner-data)
                } {
                  parts | Take(2) | ExpectString | Do(handle-practitioner)
                }
              )
            } {
              parts | Take(2) | ExpectString | Do(handle-practitioner)
            }
          )
        }
        {true} {
          @html-page("Not Found" "<h2>404</h2><p>Page not found.</p>") = page
          page | Http.Response(404 Headers: @html-headers)
          none | Stop
        }
      ] Passthrough: true)
    }
    "POST" {
      raw-body | ExpectString | Await(FromJson) | ExpectTable = post-body

      target | Cond([
        {Is("/api/contribute")} {
          post-body | Do(handle-contribute-post)
        }
        {String.Starts(With: "/api/review/")} {
          target | String.Split("/") = parts
          ; /api/review/:id/:action -> ["" "api" "review" id action]
          parts | Take(3) | ExpectString = review-id
          parts | Take(4) | ExpectString = review-action

          review-action | Match([
            "approve" {
              review-id | Do(handle-review-approve)
            }
            "reject" {
              ; validate reason field exists
              "" >= reject-reason-val
              post-body | Take("reason") | When(IsString {
                ExpectString > reject-reason-val
              })
              reject-reason-val | When(Is("") {
                {"error": "reason is required"} | Await(ToJson) | Http.Response(400 Headers: @json-headers)
                none | Stop
              })
              {id: review-id reason: reject-reason-val} | Do(handle-review-reject)
            }
            none {
              "Bad Request" | Http.Response(400 Headers: @html-headers)
              none | Stop
            }
          ] Passthrough: true)
        }
        {true} {
          "Not Found" | Http.Response(404 Headers: @json-headers)
          none | Stop
        }
      ] Passthrough: true)
    }
    none {
      "Method Not Allowed" | Http.Response(405 Headers: @html-headers)
      none | Stop
    }
  ] Passthrough: true)
  none
})

@wire(safe-server-handler {
  Maybe(
    Do(server-handler)
    {
      "Internal Server Error" | Http.Response(500 Headers: @html-headers)
      none | Stop
    }
  )
  none
} Looped: true)

@wire(server {
  Http.Server(Port: #(@http-port | ToInt) Handler: safe-server-handler)
} Looped: true)
