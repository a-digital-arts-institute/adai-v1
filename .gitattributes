# Mark generated canon as binary-for-diff: the files are committed (Docker
# builder needs them in context), but git/GitHub render them as "Binary
# files differ" rather than a 200k-line diff that no human can review.
# To inspect substantive changes, read the producer commit + run the
# gatherer + diff with `git diff --text` locally.
seed/nodes.json         -diff merge=union
seed/edges.json         -diff merge=union
seed/signals.json       -diff merge=union
seed/aliases.json       -diff merge=union
seed/contributors.json  -diff merge=union
seed/image_overlay.json -diff merge=union
seed/canon_overlay.json -diff merge=union

# Embedding sidecars — committed binaries / sparse JSON, never reviewable.
seed/embeddings.bin       -diff binary
seed/embeddings.json      -diff

# Archived run artifacts — historical, frozen, kept for provenance.
# Don't pollute diff/blame with them.
seed/_build/archive/** -diff -text
