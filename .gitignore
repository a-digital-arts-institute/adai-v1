# ─────────────────────────────────────────────────────────────────────────────
# Secrets & environment
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
.env.py
proton-recovery-kit.pdf

# Local-only operator token cache (raw admin/contributor bearer tokens — never
# sync). Re-inserted via `just restore-tokens` / `npm run token:restore` after
# a volume wipe. See .tokens.json.example for the schema.
.tokens.json

# ─────────────────────────────────────────────────────────────────────────────
# Build outputs / runtime
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
dist/

# Pre-compressed static siblings — build output (scripts/precompress.mjs, baked
# in the Dockerfile, served by src/index.ts). Generated, never committed. NB: if
# you run `npm run precompress` locally the dev server serves these STALE until
# you re-run or delete them — that's why `npm run dev` skips the step.
public/field/**/*.br
public/field/**/*.gz

# SQLite (local dev DB, WAL sidecars)
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc
*.pyo
seed/_build/.venv/

# ─────────────────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────────────────
/tmp/
*.log
errors.log
pipeline.log
shards.log

# ─────────────────────────────────────────────────────────────────────────────
# Editor / OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# Claude Code project memory (local only)
# ─────────────────────────────────────────────────────────────────────────────
.claude/

# ─────────────────────────────────────────────────────────────────────────────
# seed/ — committed canon is the source of truth.
# Ignore intermediate / cache / ephemeral files only.
# ─────────────────────────────────────────────────────────────────────────────

# Backup files from older enrichment passes
seed/*.bak
seed/*.pre-enrichment.bak

# Per-source HTTP caches (gatherers re-download as needed)
seed/_build/.cache/

# Image-fetch cache for the multimodal embedder
seed/_build/.image_cache.sqlite
seed/_build/.image_cache.sqlite-shm
seed/_build/.image_cache.sqlite-wal

# Ephemeral diagnostic outputs (regenerable per run)
seed/_build/image_sanitize_report.json
concepts_cache.json

# Oversized-image shrinker: the repoint patch is a transient artifact —
# shrink_oversized.py --apply emits it, apply-image-patch.js consumes it.
seed/_build/shrink_patch.json

# Per-gatherer run artifacts — staged in runs/<YYYY-MM>/<source>-<ts>.json
# and folded into canon by merge_batches.py. Ephemeral by design.
# (Archived outputs from PRIOR runs live in seed/_build/archive/runs/.)
seed/_build/runs/

# Pre-merge staged batches from older fetcher prototypes
seed/_build/task3_input.json
seed/_build/fxhash_new_artworks.json
seed/_build/moma_new_artworks.json

# ─────────────────────────────────────────────────────────────────────────────
# Notion / external setup artifacts
# ─────────────────────────────────────────────────────────────────────────────
schema_update_log.txt
notion_ids.txt

# ─────────────────────────────────────────────────────────────────────────────
# Misc large binaries kept locally
# ─────────────────────────────────────────────────────────────────────────────
Brief/
Meeting notes/
*.mp4
*.pptx
*.docx
*.pdf

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: seed/embeddings.{bin,json} are intentionally NOT ignored
# (decision May 2026) so the Docker builder bakes them into seed.db. Recreate
# via:
#   seed/_build/.venv/bin/python3 seed/_build/embed_nodes.py
# then commit. Stripping them here silently breaks embeddings on next build.
# ─────────────────────────────────────────────────────────────────────────────
